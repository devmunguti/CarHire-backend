NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/autohire?replicaSet=rs0
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# Configure SMTP to enable staff invitations, password resets, and contact delivery.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CONTACT_INBOX=hello@autohire.ke

# Store uploaded driving licences in a private directory outside the web root.
PRIVATE_UPLOAD_DIR=./private-files

# Configure Cloudinary to enable fleet vehicle image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Configure PayHero to enable live STK requests. Keep credentials in .env only.
PAYHERO_API_BASE_URL=https://backend.payhero.co.ke
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=
